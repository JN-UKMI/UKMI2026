    },
    {
      "title": "Grebeg Wisuda",
      "description": "Apresiasi, ucapan selamat, dan doa secara luring/daring kepada alumni JN UKMI yang telah lulus menempuh pendidikan."
    },
    {
      "title": "Forum Masyarakat (Formas) Lembaga Dakwah UNS",
      "description": "Wadah silaturahmi, pertukaran informasi, dan koordinasi kolaborasi antar 13 Lembaga Dakwah Fakultas (LDF) se-UNS."
    },
    {
      "title": "Dusun Binaan (DusBin)",
      "description": "Pengabdian masyarakat dan pembinaan TPA interaktif, public speaking, serta pelatihan keterampilan anak-anak di dusun binaan."
    },
    {
      "title": "Qurban Bersama Masyarakat (Qurma)",
      "description": "Penggalangan dana, penyembelihan, dan penyaluran daging qurban bagi masyarakat membutuhkan di daerah binaan."
    },
    {
      "title": "SOSMA Berbagi",
      "description": "Program kepedulian sosial berupa interaksi kebersamaan dan penyaluran bantuan ke lembaga sosial/panti secara berkala."
    },
    {
      "title": "MEDIA SOSMA",
      "description": "Pengelolaan platform media digital khusus untuk publikasi dan dokumentasi seluruh kegiatan sosial kemasyarakatan SOSMA JN UKMI."
    }
