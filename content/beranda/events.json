{
  "monthly_quotes": {
    "2026-04": {
      "text": "Barang siapa berpuasa Ramadhan kemudian mengikutkannya 6 hari dari bulan Syawal, maka seperti puasa satu tahun.",
      "source": "HR. Muslim"
    },
    "2026-05": {
      "text": "Tidak ada hari-hari yang lebih Allah sukai untuk beribadah selain sepuluh hari pertama bulan Dzulhijjah, satu hari berpuasa di dalamnya setara dengan satu tahun berpuasa...",
      "source": "HR. At-Tirmidzi"
    },
    "2026-06": {
      "text": "Puasa yang paling utama setelah (puasa) Ramadhan puasa pada bulan Allah, yakni Muharram.",
      "source": "HR. Muslim"
    },
    "2026-07": {
      "text": "Berbagai amalan dihadapkan (pada Allah) pada hari Senin dan Kamis, maka aku suka jika amalanku dihadapkan sedangkan aku sedang berpuasa.",
      "source": "HR. Tirmidzi no. 747"
    }
  },
